{
  "name": "chat-gideon",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.realtime.config.ts",
    "dev:cloudflare": "vite dev --mode cloudflare",
    "build:cloudflare": "vite build --mode cloudflare && tsc --noEmit",
    "preview:cloudflare": "vite preview --mode cloudflare",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "deploy": "npm run deploy:cloudflare",
    "cf:typegen": "wrangler types",
    "preview": "node server/serve.mjs",
    "start": "node server/serve.mjs",
    "test": "vitest run",
    "benchmark:models": "node scripts/benchmark-models.mjs",
    "benchmark:research": "vitest run src/lib/tools/research.live.test.ts --mode live",
    "benchmark:cards": "vitest run src/lib/tools/card-builder.live.test.ts --mode live",
    "benchmark:judge": "vitest run src/lib/stage-judge.live.test.ts --mode live"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/three": "^0.184.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.545.0",
    "onnxruntime-web": "1.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.184.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "nitro": "npm:nitro-nightly@^3.0.1-20260828-140537-5d83475c",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
