OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Accounts. At least 32 random characters: `openssl rand -base64 32`.
# Also needs the HYPERDRIVE binding (see backend/worker/README.md). Without
# both, memory is ephemeral and isolated.
BETTER_AUTH_SECRET=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_CHAT_FALLBACK_MODEL=minimax/minimax-m3:free
OPENROUTER_VOICE_MODEL=fish-audio/s2.1-pro
OPENROUTER_VOICE=933563129e564b19a115bedd57b7406a
OPENROUTER_STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
OPENROUTER_STT_FALLBACK_MODEL=deepgram/nova-3

# Optional live research. Leave empty if research is not needed yet.
EXA_API_KEY=

# Optional maps. Without the public token, show_map is not offered. The public
# token is sent to browsers; restrict it by URL in the Mapbox account. The server
# token is optional, and is used for search and directions when it has the scopes.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SERVER_TOKEN=

# Public deployment origin guard. The demo itself has no access-code requirement.
GIDEON_ALLOWED_ORIGINS=http://localhost:5173
GIDEON_RATE_LIMIT=auto

# Optional REST route to the same memory table. Ignored when HYPERDRIVE is
# bound. Leave both empty to use Durable Object storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
