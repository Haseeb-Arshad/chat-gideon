{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat-gideon",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "backend/worker/src/server.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "GIDEON_SESSION",
        "class_name": "GideonSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GideonSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
