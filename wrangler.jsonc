{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat-gideon",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "backend/worker/src/server.ts",
  "vars": {
    "GIDEON_ALLOWED_ORIGINS": "https://chatgideon.com,https://www.chatgideon.com",
    "OPENROUTER_SITE_URL": "https://chatgideon.com"
  },
  // Accounts and account memory live in Supabase PostgreSQL, reached through
  // Hyperdrive. Create the config once, with the direct connection string, and
  // put its id here (see backend/worker/README.md). `npm run db:migrate` must
  // succeed before code depending on a migration is deployed.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d3b0f930e77044aebdd18a06ee11a736" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "GIDEON_SESSION",
        "class_name": "GideonSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GideonSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
