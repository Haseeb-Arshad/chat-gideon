{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat-gideon",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "backend/worker/src/server.ts",
  "vars": {
    "GIDEON_ALLOWED_ORIGINS": "https://chatgideon.com,https://www.chatgideon.com",
    "OPENROUTER_SITE_URL": "https://chatgideon.com"
  },
  // Accounts. No database_id: the first `wrangler deploy` creates the database
  // and writes its id back here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat-gideon",
      "migrations_dir": "backend/worker/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GIDEON_SESSION",
        "class_name": "GideonSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GideonSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
