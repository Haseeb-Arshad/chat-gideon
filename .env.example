# Server-only OpenRouter credential. Never prefix this with VITE_.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Models. The chat model must support tool calling for GIDEON to act on your
# behalf; without it the agent loop degrades to plain conversation.
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_CHAT_FALLBACK_MODEL=minimax/minimax-m3:free
# Microsoft MAI-Voice-2.1-Flash. Azure voice IDs must include the model suffix.
OPENROUTER_VOICE_MODEL=microsoft/mai-voice-2.1-flash
OPENROUTER_VOICE=en-US-Harper:MAI-Voice-2.1-Flash

# Speech to text. Chosen by measuring median round trip over five interleaved
# reps of a short spoken sentence: parakeet 367ms, nova-3 409ms,
# voxtral-mini 535ms, mai-transcribe-2 603ms, qwen3-asr-0.6b 870ms,
# whisper-large-v3-turbo 1380ms. All transcribed it exactly, so latency decided
# it. Roughly six cents per thousand turns.
OPENROUTER_STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
OPENROUTER_STT_FALLBACK_MODEL=deepgram/nova-3
OPENROUTER_SITE_URL=http://localhost:3000

# PostHog analytics and Self-driving. The project token is safe for the browser
# but must belong to the PostHog project used by this deployment.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=replace_with_your_posthog_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Node account memory is isolated per signed owner. Set a random 32+ character
# secret in production to preserve account cookies across process restarts.
GIDEON_IDENTITY_SECRET=
GIDEON_MEMORY_DIR=.gideon/memories
# Stage 03 server-only PostgreSQL authority. Keep this unset until the
# isolated backend is explicitly enabled by a later integration stage.
# GIDEON_MEMORY_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/gideon_memory
# GIDEON_MEMORY_POOL_MAX=8
# GIDEON_MEMORY_CONNECTION_TIMEOUT_MS=3000
# GIDEON_MEMORY_IDLE_TIMEOUT_MS=30000
# GIDEON_MEMORY_STATEMENT_TIMEOUT_MS=10000
# GIDEON_MEMORY_PATH=none disables disk persistence (legacy compatibility).
# Stage 09 capability flags (server-side, default off; production also needs
# GIDEON_MEMORY_STAGE15_CUTOVER=1).
# GIDEON_MEMORY_ROLLOUT_PERCENT=0
# GIDEON_MEMORY_CAPTURE_ENABLED=1
# GIDEON_MEMORY_COMMAND_WRITES_ENABLED=1
# GIDEON_MEMORY_RECALL_ENABLED=1
# Stage 10 background maintenance and implicit learning (default off).
# GIDEON_MEMORY_BACKGROUND_ENABLED=1
# GIDEON_MEMORY_BACKGROUND_INTERVAL_MS=10000
# GIDEON_MEMORY_LEARNING_ENABLED=1
# Local rules are the default extractor. Paid model extraction needs BOTH:
# GIDEON_MEMORY_EXTRACTOR=model
# GIDEON_MEMORY_EXTRACTOR_REMOTE_ALLOWED=1
# GIDEON_MEMORY_EXTRACTOR_MODEL=openai/gpt-6-luna
# Plan B: enable only for a configured canonical owner after migrations/cutover.
# GIDEON_MEMORY_CANONICAL_ONLY=1
# GIDEON_MEMORY_CUTOVER_ENABLED=1
# GIDEON_MEMORY_STAGE15_CUTOVER=1
# GIDEON_MEMORY_EMBEDDINGS_REMOTE_ALLOWED=1
# GIDEON_MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
# GIDEON_MEMORY_EMBEDDING_DIMENSIONS=512
# The memory lookup in front of each reply reads the database and, beside it,
# asks for an embedding of the question. Once the database branches have
# answered it waits this many more milliseconds for the embedding and then goes
# on without it (default 80; -1 waits without limit). A lookup the model asks
# for by calling recall always waits.
# GIDEON_MEMORY_SEMANTIC_GRACE_MS=80
# Record private answer traces and show the owner's learning inbox.
# GIDEON_MEMORY_REFINEMENT_ENABLED=1
# Offline refinement proposes candidates; independent verification promotes them.
# GIDEON_MEMORY_REFINER_REMOTE_ALLOWED=1
# Operator CLI paid commands additionally require MEMORY_PLANB_LIVE=1.
# Trust only actual reverse-proxy peer IPs, never arbitrary forwarded headers.
# GIDEON_TRUSTED_PROXIES=

# Enables the research tool. Without it GIDEON is not offered research at
# all, and says it cannot check anything live rather than guessing.
# EXA_API_KEY=

# Enables show_map: where a place is, and the way between two. The public token
# (pk.) goes to the browser on every map card, so restrict it by URL in the
# Mapbox account. The secret token (sk.) is optional and stays on the server; if
# it lacks a scope a request needs, the public token is used instead. The card
# lab reads the public token as VITE_MAPBOX_PUBLIC_TOKEN, in development only.
# MAPBOX_PUBLIC_TOKEN=
# MAPBOX_SERVER_TOKEN=
# VITE_MAPBOX_PUBLIC_TOKEN=

# The research desk: a stronger model that searches the web through Exa and
# hands the speaking model a brief. Effort defaults to none because it was
# measured: against low, it gave the same answers in 3.5 to 6.4 seconds instead
# of 6.2 to 7.5, since low spent the difference cross-checking sources that
# already agreed.
# OPENROUTER_RESEARCH_MODEL=openai/gpt-5.6-luna
# OPENROUTER_RESEARCH_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# OPENROUTER_RESEARCH_EFFORT=none

# Public-deployment guards. Origins default to same-origin only; set the
# allowlist only if the page is embedded elsewhere. The public demo has no
# access-code requirement.
# GIDEON_ALLOWED_ORIGINS=https://your-portfolio.example

# Rate limiting: auto (default), on, or off. Auto meters public hosts and
# leaves localhost alone, because the limiter exists so a public URL is not a
# free key and there is nobody to protect against on your own machine. The
# ceilings are set above what a person can produce by talking; only a script
# should ever reach one.
# GIDEON_RATE_LIMIT=auto

# The dev server and the realtime socket both bind here.
# PORT=3000

# Optional split deployment. Leave both unset when the frontend and Worker are
# deployed together, which is the recommended Cloudflare setup.
# VITE_GIDEON_BACKEND_URL=https://your-worker.workers.dev
# VITE_GIDEON_BACKEND_WS_URL=wss://your-worker.workers.dev/api/realtime
