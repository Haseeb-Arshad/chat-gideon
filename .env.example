# Server-only OpenRouter credential. Never prefix this with VITE_.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Models. The chat model must support tool calling for GIDEON to act on your
# behalf; without it the agent loop degrades to plain conversation.
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_CHAT_FALLBACK_MODEL=minimax/minimax-m3:free
OPENROUTER_VOICE_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_VOICE=alloy
OPENROUTER_SITE_URL=http://localhost:3000

# Where durable memories are written. Unset means memory lives only as long as
# the process, which is the honest default for a serverless host with no disk.
GIDEON_MEMORY_PATH=.gideon/memory.json

# Enables the web_search tool. Without it GIDEON says it cannot search rather
# than guessing at anything live.
# TAVILY_API_KEY=

# Public-deployment guards. An access code, when set, is required on every
# request. Origins default to same-origin only; set this only if the page is
# embedded somewhere else.
# GIDEON_ACCESS_CODE=
# GIDEON_ALLOWED_ORIGINS=https://your-portfolio.example

# The dev server and the realtime socket both bind here.
# PORT=3000
