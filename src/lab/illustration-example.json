  "query": "Draw an interactive isometric spring balance on warm paper. Slider labelled Load from 0 to 10 N, a dial and a visible spring stretching. Illustrative spring constant 100 N/m; readout extension in cm calculated from Hooke law. Reset button.",
  "title": "Spring Balance — Isometric Model",
  "blocks": [
    {
      "id": "drawing",
      "slot": "body",
      "type": "illustration",
      "title": "Spring Balance — Isometric Model",
      "summary": "An isometric spring balance illustrates Hooke's Law by stretching a coil spring proportional to an applied load; extension = F/k with k = 100 N/m (illustrative). This is a simplified model: coil geometry is schematic, no damping or nonlinear effects are shown.",
      "html": "<style>\n  .sb-wrap{font-family:system-ui,sans-serif;max-width:900px;margin:0 auto;padding:12px 16px;box-sizing:border-box;}\n  .sb-title{font-size:1.1rem;font-weight:700;color:#5a3e1b;margin:0 0 2px;}\n  .sb-hint{font-size:.78rem;color:#8a6a3a;margin:0 0 8px;}\n  .sb-layout{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-start;}\n  .sb-canvas-col{flex:1 1 300px;min-width:260px;}\n  .sb-controls-col{flex:0 0 200px;min-width:180px;display:flex;flex-direction:column;gap:10px;}\n  .iso{display:block;width:100%;border-radius:10px;overflow:hidden;}\n  .iso-svg{display:block;width:100%;height:auto;}\n  .sb-ctrl-group{background:rgba(180,140,80,.13);border-radius:8px;padding:10px 12px;}\n  .sb-ctrl-group label{display:block;font-size:.8rem;font-weight:600;color:#5a3e1b;margin-bottom:4px;}\n  .sb-ctrl-group input[type=range]{width:100%;accent-color:#b05a10;}\n  .sb-readout{background:#fdf3e3;border:1.5px solid #c8a060;border-radius:8px;padding:10px 12px;font-size:.85rem;color:#3a2800;}\n  .sb-readout strong{display:block;font-size:1.05rem;color:#b05a10;}\n  .sb-reset{background:#b05a10;color:#fff;border:none;border-radius:7px;padding:8px 18px;font-size:.85rem;font-weight:700;cursor:pointer;width:100%;}\n  .sb-reset:hover{background:#8a3e08;}\n  .sb-caption{font-size:.72rem;color:#8a6a3a;margin:8px 0 0;line-height:1.5;}\n  @media(max-width:500px){.sb-controls-col{flex:1 1 100%;flex-direction:row;flex-wrap:wrap;}.sb-ctrl-group,.sb-readout,.sb-reset{flex:1 1 140px;}}\n</style>\n<div class='sb-wrap'>\n  <p class='sb-title'>Spring Balance — Isometric Model</p>\n  <p class='sb-hint'>Drag the slider or use arrow keys to apply load. Watch the spring stretch and the dial rotate.</p>\n  <div class='sb-layout'>\n    <div class='sb-canvas-col'>\n      <div class='iso' data-theme='light' id='sbIso'>\n        <svg class='iso-svg' id='sbSvg' viewBox='0 0 480 560' role='img' aria-label='Isometric spring balance diagram'></svg>\n      </div>\n    </div>\n    <div class='sb-controls-col'>\n      <div class='sb-ctrl-group'>\n        <label for='loadSlider'>Load (N): <span id='loadVal'>0.0</span></label>\n        <input type='range' id='loadSlider' min='0' max='10' step='0.1' value='0' aria-label='Load in Newtons'>\n      </div>\n      <div class='sb-readout' aria-live='polite' id='readout'>\n        <strong id='extVal'>Extension: 0.00 cm</strong>\n        <span id='forceVal'>Force: 0.0 N</span><br>\n        <span id='hookVal'>F = k·x = 100 × 0.000 m</span>\n      </div>\n      <button class='sb-reset' id='resetBtn'>Reset</button>\n      <p class='sb-caption'>⚠ Simplified illustrative model. Spring constant k = 100 N/m is invented for demonstration. Not a measurement or verified specification.</p>\n    </div>\n  </div>\n</div>\n<script>\n(function(){\n  const k = window.Anatomy;\n  if(!k){document.getElementById('sbSvg').innerHTML='<text x=\"10\" y=\"30\" fill=\"red\">Anatomy kit not loaded</text>';return;}\n\n  const SVG_W = 480, SVG_H = 560;\n  const K_SPRING = 100; // N/m illustrative\n\n  // World bounds for projection\n  const allPts = [\n    [-80,-80,0],[-80,-80,320],[80,-80,0],[80,80,0],[-80,80,0],\n    [-80,-80,320],[80,-80,320],[80,80,320],[-80,80,320]\n  ];\n  const P = k.fitProjection(allPts, SVG_W, SVG_H, {pad:40, azimuth:35, elevation:28});\n\n  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}\n\n  // ---- Static geometry helpers ----\n  function screwSvg(cx,cy,cz,P){\n    const sc = k.iso([cx,cy,cz],P);\n    const sr = 5;\n    return `<circle cx='${sc[0].toFixed(1)}' cy='${sc[1].toFixed(1)}' r='${sr}' fill='#8a6a3a' stroke='#5a3e1b' stroke-width='1'/>\n            <line x1='${(sc[0]-3).toFixed(1)}' y1='${sc[1].toFixed(1)}' x2='${(sc[0]+3).toFixed(1)}' y2='${sc[1].toFixed(1)}' stroke='#3a2800' stroke-width='1.2'/>\n            <line x1='${sc[0].toFixed(1)}' y1='${(sc[1]-3).toFixed(1)}' x2='${sc[0].toFixed(1)}' y2='${(sc[1]+3).toFixed(1)}' stroke='#3a2800' stroke-width='1.2'/>`;\n  }\n\n  function isoLine(a,b,P,stroke,sw){\n    const pa=k.iso(a,P), pb=k.iso(b,P);\n    return `<line x1='${pa[0].toFixed(1)}' y1='${pa[1].toFixed(1)}' x2='${pb[0].toFixed(1)}' y2='${pb[1].toFixed(1)}' stroke='${stroke}' stroke-width='${sw}' stroke-linecap='round'/>`;\n  }\n\n  function isoCircle(cx,cy,cz,r,fill,stroke,sw,P){\n    const sc=k.iso([cx,cy,cz],P);\n    return `<circle cx='${sc[0].toFixed(1)}' cy='${sc[1].toFixed(1)}' r='${r}' fill='${fill}' stroke='${stroke}' stroke-width='${sw}'/>`;\n  }\n\n  // ---- Build static SVG parts ----\n  function buildStatic(){\n    let s = '';\n\n    // === BENCH / BASE ===\n    const benchPlan = {x:-90,y:-70,w:180,d:140,r:4};\n    const bench = k.slabOf(benchPlan, 0, 14, P, 8, 2);\n    s += k.solidSvg(bench, {tone:'mid'});\n\n    // Bench screws\n    s += screwSvg(-70,-50,14,P);\n    s += screwSvg( 70,-50,14,P);\n    s += screwSvg(-70, 50,14,P);\n    s += screwSvg( 70, 50,14,P);\n\n    // Rubber feet\n    const footPlan1 = {x:-82,y:-62,w:18,d:18,r:3};\n    const footPlan2 = {x: 64,y:-62,w:18,d:18,r:3};\n    const footPlan3 = {x:-82,y: 44,w:18,d:18,r:3};\n    const footPlan4 = {x: 64,y: 44,w:18,d:18,r:3};\n    [footPlan1,footPlan2,footPlan3,footPlan4].forEach(fp=>{\n      const ft = k.slabOf(fp,-8,8,P,6,1);\n      s += k.solidSvg(ft,{tone:'lo'});\n    });\n\n    // === BODY COLUMN ===\n    const bodyPlan = {x:-28,y:-22,w:56,d:44,r:5};\n    const body = k.slabOf(bodyPlan, 14, 220, P, 8, 3);\n    s += k.solidSvg(body, {tone:'hi'});\n\n    // Body screws (decorative bolts on sides)\n    s += screwSvg(-28,-22,80,P);\n    s += screwSvg( 28,-22,80,P);\n    s += screwSvg(-28,-22,160,P);\n    s += screwSvg( 28,-22,160,P);\n\n    // === TOP CAP ===\n    const capPlan = {x:-32,y:-26,w:64,d:52,r:6};\n    const cap = k.slabOf(capPlan, 234, 16, P, 8, 2);\n    s += k.solidSvg(cap, {tone:'mid'});\n\n    // Top hook mount\n    const hookMount = k.slabOf({x:-10,y:-8,w:20,d:16,r:3}, 250, 20, P, 6, 1);\n    s += k.solidSvg(hookMount, {tone:'lo'});\n\n    // Top hook (static arc)\n    const hkTop = k.iso([0,0,270],P);\n    const hkMid = k.iso([0,-18,278],P);\n    const hkBot = k.iso([0,-18,260],P);\n    s += `<path d='M${hkTop[0].toFixed(1)},${hkTop[1].toFixed(1)} Q${hkMid[0].toFixed(1)},${hkMid[1].toFixed(1)} ${hkBot[0].toFixed(1)},${hkBot[1].toFixed(1)}' fill='none' stroke='#5a3e1b' stroke-width='4' stroke-linecap='round'/>`;\n\n    // === DIAL FACE (static background) ===\n    const dialCentre = k.iso([0,0,190],P);\n    s += `<circle cx='${dialCentre[0].toFixed(1)}' cy='${dialCentre[1].toFixed(1)}' r='30' fill='#fdf3e3' stroke='#8a6a3a' stroke-width='2'/>`;\n    // Dial tick marks\n    for(let i=0;i<=10;i++){\n      const ang = -Math.PI/2 + (i/10)*Math.PI*1.5;\n      const r1 = (i%5===0)?22:25;\n      const r2 = 28;\n      const x1 = dialCentre[0]+r1*Math.cos(ang);\n      const y1 = dialCentre[1]+r1*Math.sin(ang);\n      const x2 = dialCentre[0]+r2*Math.cos(ang);\n      const y2 = dialCentre[1]+r2*Math.sin(ang);\n      s += `<line x1='${x1.toFixed(1)}' y1='${y1.toFixed(1)}' x2='${x2.toFixed(1)}' y2='${y2.toFixed(1)}' stroke='#5a3e1b' stroke-width='${i%5===0?1.8:1}'/>`;\n    }\n    // Dial label\n    s += `<text x='${dialCentre[0].toFixed(1)}' y='${(dialCentre[1]+42).toFixed(1)}' text-anchor='middle' font-size='9' fill='#5a3e1b' font-family='system-ui'>N</text>`;\n    // Dial centre dot\n    s += `<circle cx='${dialCentre[0].toFixed(1)}' cy='${dialCentre[1].toFixed(1)}' r='3' fill='#b05a10'/>`;\n\n    // === GUIDE RAIL (inside body, vertical line) ===\n    s += isoLine([0,0,30],[0,0,230],P,'#c8a060',1.5);\n\n    // === COLLAR / SLIDER RING (static outer) ===\n    // drawn in dynamic section\n\n    return s;\n  }\n\n  // ---- Build dynamic SVG (spring + hook + weight + dial needle) ----\n  function buildDynamic(load){\n    const ext = load / K_SPRING; // metres\n    const extPx = ext * 1000; // scale: 1m = 1000 world units, so 0.1m = 100 units\n    // max extension at 10N = 0.1m = 100 world units\n    // spring top fixed at z=30 (bench top + body base), bottom moves down\n    const springTopZ = 30;\n    const springBotZ = springTopZ - extPx; // moves downward (lower z)\n    // weight hangs below spring bottom\n    const weightZ = springBotZ - 30;\n\n    let s = '';\n\n    // === SPRING COILS ===\n    const coilCount = 10;\n    const coilR = 14;\n    const totalSpringLen = 100 + extPx; // natural length 100 + extension\n    const coilStep = totalSpringLen / (coilCount * 2);\n    // Draw coils as zigzag in iso space\n    let coilPts = [];\n    for(let i=0;i<=coilCount*2;i++){\n      const frac = i/(coilCount*2);\n      const zz = springTopZ + 14 + frac*(totalSpringLen - 28);\n      // alternate left/right in x\n      const side = (i%2===0)?1:-1;\n      coilPts.push([side*coilR, 0, zz]);\n    }\n    // Draw coil path\n    let coilPath = '';\n    coilPts.forEach((pt,i)=>{\n      const sp = k.iso(pt,P);\n      coilPath += (i===0?`M${sp[0].toFixed(1)},${sp[1].toFixed(1)}`:`L${sp[0].toFixed(1)},${sp[1].toFixed(1)}`);\n    });\n    s += `<path d='${coilPath}' fill='none' stroke='#b05a10' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>`;\n    // Coil shadow/depth lines\n    let coilPath2 = '';\n    coilPts.forEach((pt,i)=>{\n      const pt2 = [pt[0]*0.6, pt[1]+8, pt[2]];\n      const sp = k.iso(pt2,P);\n      coilPath2 += (i===0?`M${sp[0].toFixed(1)},${sp[1].toFixed(1)}`:`L${sp[0].toFixed(1)},${sp[1].toFixed(1)}`);\n    });\n    s += `<path d='${coilPath2}' fill='none' stroke='#8a3e08' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' opacity='0.5'/>`;\n\n    // Spring top connector\n    s += isoLine([0,0,springTopZ+14],[0,0,springTopZ],P,'#8a6a3a',3);\n    // Spring bottom connector\n    s += isoLine([0,0,springTopZ+totalSpringLen-14],[0,0,springBotZ],P,'#8a6a3a',3);\n\n    // === COLLAR (moves with spring bottom) ===\n    const collarPlan = {x:-20,y:-16,w:40,d:32,r:4};\n    const collar = k.slabOf(collarPlan, springBotZ-8, 8, P, 6, 1);\n    s += k.solidSvg(collar, {tone:'lo'});\n    // Collar screws\n    s += screwSvg(-16,-12,springBotZ,P);\n    s += screwSvg( 16,-12,springBotZ,P);\n\n    // === LOWER HOOK ===\n    const lhkTop = k.iso([0,0,springBotZ-8],P);\n    const lhkMid = k.iso([0,-20,springBotZ-18],P);\n    const lhkBot = k.iso([0,-20,springBotZ-32],P);\n    s += `<path d='M${lhkTop[0].toFixed(1)},${lhkTop[1].toFixed(1)} Q${lhkMid[0].toFixed(1)},${lhkMid[1].toFixed(1)} ${lhkBot[0].toFixed(1)},${lhkBot[1].toFixed(1)}' fill='none' stroke='#5a3e1b' stroke-width='4' stroke-linecap='round'/>`;\n\n    // === WEIGHT (only visible if load > 0) ===\n    if(load > 0){\n      const wSize = 12 + load*2.5; // grows with load\n      const wPlan = {x:-wSize/2,y:-wSize/2*0.8,w:wSize,d:wSize*0.8,r:3};\n      const weight = k.slabOf(wPlan, weightZ-wSize*0.6, wSize*0.6, P, 6, 1);\n      s += k.solidSvg(weight, {tone:'mid'});\n      // Weight label\n      const wCentre = k.iso([0,0,weightZ-wSize*0.3],P);\n      s += `<text x='${wCentre[0].toFixed(1)}' y='${(wCentre[1]+4).toFixed(1)}' text-anchor='middle' font-size='9' font-weight='bold' fill='#3a2800' font-family='system-ui'>${load.toFixed(1)}N</text>`;\n      // Hook-to-weight connector\n      s += isoLine([0,-20,springBotZ-32],[0,0,weightZ],P,'#5a3e1b',2.5);\n    }\n\n    // === DIAL NEEDLE ===\n    const dialCentre = k.iso([0,0,190],P);\n    const needleAngle = -Math.PI/2 + (load/10)*Math.PI*1.5;\n    const needleLen = 20;\n    const nx = dialCentre[0] + needleLen*Math.cos(needleAngle);\n    const ny = dialCentre[1] + needleLen*Math.sin(needleAngle);\n    s += `<line x1='${dialCentre[0].toFixed(1)}' y1='${dialCentre[1].toFixed(1)}' x2='${nx.toFixed(1)}' y2='${ny.toFixed(1)}' stroke='#b05a10' stroke-width='2.5' stroke-linecap='round'/>`;\n    // Needle centre cap\n    s += `<circle cx='${dialCentre[0].toFixed(1)}' cy='${dialCentre[1].toFixed(1)}' r='3.5' fill='#b05a10'/>`;\n\n    // === EXTENSION ANNOTATION ===\n    if(ext > 0.001){\n      const topPt = k.iso([40,0,springTopZ+14],P);\n      const botPt = k.iso([40,0,springBotZ+totalSpringLen-14],P);\n      s += `<line x1='${topPt[0].toFixed(1)}' y1='${topPt[1].toFixed(1)}' x2='${botPt[0].toFixed(1)}' y2='${botPt[1].toFixed(1)}' stroke='#b05a10' stroke-width='1' stroke-dasharray='3,2'/>`;\n      const midY = (topPt[1]+botPt[1])/2;\n      const midX = (topPt[0]+botPt[0])/2 + 6;\n      s += `<text x='${midX.toFixed(1)}' y='${midY.toFixed(1)}' font-size='9' fill='#b05a10' font-family='system-ui'>${(ext*100).toFixed(1)}cm</text>`;\n    }\n\n    return s;\n  }\n\n  function render(load){\n    const svg = document.getElementById('sbSvg');\n    const staticPart = buildStatic();\n    const dynPart = buildDynamic(load);\n    svg.innerHTML = staticPart + dynPart;\n  }\n\n  function updateReadout(load){\n    const ext = load / K_SPRING;\n    document.getElementById('extVal').textContent = `Extension: ${(ext*100).toFixed(2)} cm`;\n    document.getElementById('forceVal').textContent = `Force: ${load.toFixed(1)} N`;\n    document.getElementById('hookVal').textContent = `F = k x = 100 x ${ext.toFixed(3)} m`;\n    document.getElementById('loadVal').textContent = load.toFixed(1);\n  }\n\n  const slider = document.getElementById('loadSlider');\n  const resetBtn = document.getElementById('resetBtn');\n\n  slider.addEventListener('input', function(){\n    const v = parseFloat(this.value);\n    render(v);\n    updateReadout(v);\n  });\n\n  resetBtn.addEventListener('click', function(){\n    slider.value = 0;\n    render(0);\n    updateReadout(0);\n  });\n\n  // Initial render\n  render(0);\n  updateReadout(0);\n\n})();\n</script>"
    }
  ],
